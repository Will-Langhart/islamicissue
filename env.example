# Copy the values you need into .env (which is gitignored). On Vercel, set these
# with `vercel env add` and pull them locally with `vercel env pull .env`.

# --- Chatbot (existing) ---
ANTHROPIC_API_KEY=

# --- Auth (Supabase) ---
# Project URL + publishable anon key. Safe to expose to the browser; Row-Level
# Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_
# and never use it in client code. (Not needed until Phase 4 moderation reads.)
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (existing, optional) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
